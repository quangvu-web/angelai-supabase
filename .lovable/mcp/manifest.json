{
  "version": 1,
  "sdk_version": "3.1.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "angel-fun-kingdom-mcp",
      "version": "0.1.0",
      "title": "Angel AI · FUN Kingdom"
    },
    "tools": [
      {
        "name": "ask_angel",
        "title": "Ask Angel AI",
        "description": "Ask Angel AI — the spiritual assistant of FUN Kingdom — a question. Returns Angel's reply grounded in the FUN Kingdom knowledge base (Cha Vũ Trụ doctrine, PLP protocol, Light economy, etc.).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "description": "The question or message to send to Angel AI."
            },
            "language": {
              "description": "Preferred reply language. Defaults to Vietnamese ('vi').",
              "type": "string",
              "enum": [
                "vi",
                "en"
              ]
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge",
        "title": "Search FUN Kingdom knowledge",
        "description": "Semantic search over Angel AI's public knowledge base (Cha Vũ Trụ doctrine, PLP protocol, Light economy, mini games, docs). Returns the most relevant chunks with similarity scores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Natural-language search query (Vietnamese or English)."
            },
            "limit": {
              "description": "Max chunks to return. Default 5.",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_public_profile",
        "title": "Get public FUN profile",
        "description": "Look up a FUN Kingdom member's public profile by handle (e.g. 'camly'). Returns display name, bio, and public Light metrics only. No private data.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1,
              "description": "The member's public handle, without the '@'."
            }
          },
          "required": [
            "handle"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
